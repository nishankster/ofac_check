# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to source control.

# ── OAuth 2.0 ──────────────────────────────────────────────────────────────────

# Signing key for access tokens — generate with: openssl rand -hex 32
OAUTH_SIGNING_KEY=replace-with-a-32-byte-random-hex-string

# Registered OAuth clients — JSON object: {"client_id": "client_secret", ...}
# Add one entry per system that needs access to the API.
# Example: OAUTH_CLIENTS={"compliance-system":"s3cr3t1","batch-runner":"s3cr3t2"}
OAUTH_CLIENTS={"replace-client-id":"replace-client-secret"}

# Access token lifetime in seconds (default: 3600 = 1 hour)
OAUTH_TOKEN_EXPIRE_SECONDS=3600
